# Webpay Plus (SDK oficial). WEBPAY_ENV: integration | production
# Tras commit, el servidor redirige a /compra/confirmacion (único flujo postventa).
# Link de Pago: configurar el mismo retorno en el panel Transbank.
# Copiar a .env.local y completar. Nunca hardcodear WEBPAY_API_KEY en el código.

WEBPAY_ENV=integration
WEBPAY_COMMERCE_CODE=597055555532
WEBPAY_API_KEY=
APP_URL=https://miniappsemprende.cl
WEBPAY_RETURN_URL=https://miniappsemprende.cl/api/webpay/commit
REPORT_PRICE=5990

# Supabase Auth — App Router + @supabase/ssr (documentación oficial)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Solo servidor — escrituras de licencias (bypassa RLS). Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=
